[Unit]
Description=Dinchy Redis
After=network-online.target

[Container]
# Redis 8.4+ is required: the event bus consumes with XREADGROUP ... CLAIM,
# an option added in Redis 8.4. Do not downgrade to redis:8 (8.0-8.3 lack it).
Image=docker.io/library/redis:8.4
ContainerName=dinchy-redis
Network=dinchy.network
# Nothing is published: the management plane is a container on this same network and
# reaches it by name. Nothing on the host needs it, and nothing off the host should.
# Persist Redis data across restarts.
Volume=dinchy-redis-data:/data

[Service]
Restart=always

[Install]
WantedBy=default.target
