[Unit]
Description=Dinchy management plane
Documentation=https://github.com/sidarth-23/dinchy
After=network-online.target postgres.service redis.service caddy.service
Wants=network-online.target
Requires=postgres.service redis.service
# Caddy is pulled in and started first, because Dinchy pushes its configuration once at
# startup and does not retry indefinitely. Never Requires=: if routing breaks, Dinchy is
# the only thing that can repair it, so Caddy's failure must not stop the management plane.
Wants=caddy.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dinchy
EnvironmentFile=/etc/dinchy/dinchy.env
Restart=on-failure
RestartSec=5
# Never let the OOM killer target the management plane, even during a runaway build.
OOMScoreAdjust=-1000

[Install]
WantedBy=default.target
