# Dinchy configuration. Copy to /etc/dinchy/dinchy.env and fill in.
# See deploy/README.md for how this file is loaded, precedence, and secrets handling.

# --- Server ---
# Plaintext listen address (host:port). The shared Caddy edge terminates TLS on :443 and reaches
# this across the caddy-edge network, so it binds every interface. Nothing is published to the
# host: the container is reachable only from that network.
DINCHY_ADDR=0.0.0.0:8080
# Which peers' X-Forwarded-For to honour, as CIDR blocks or bare addresses. Required once
# DINCHY_ADDR is not loopback, and Dinchy refuses to start otherwise: the value is persisted as the
# client address in audit_logs.ip_address and sessions.ip_address, so a peer that could forge it
# would be choosing what the audit log records about it. 10.89.100.0/24 is the subnet
# deploy/quadlet/caddy-edge.network pins.
DINCHY_TRUSTED_PROXIES=10.89.100.0/24
# Internal health/readiness listen address. Loopback, because the probe runs inside the container.
DINCHY_INTERNAL_ADDR=127.0.0.1:9090
# Mark every cookie Secure. Leave true: Caddy serves all routes over HTTPS.
DINCHY_SECURE_COOKIES=true

# --- The shared Caddy edge ---
# One Caddy fronts every application on this host. Dinchy renders no config file: it pushes the two
# configuration objects it owns to the edge's admin API once at startup, addressed by "@id" so other
# tenants' routes are untouched. The edge runs with --resume, so it restores every tenant's routes
# across a restart with no management plane running. Dinchy does not re-assert afterwards, so a
# change you make to the running configuration stays. See deploy/caddy/README.md.
DINCHY_CADDY_ENABLED=true
# The edge's admin API, reached by container name over caddy-edge. It is unauthenticated and can
# load any configuration, so anything able to reach it can reconfigure the whole edge — including
# other applications' routes. It is deliberately not published to the host; see
# deploy/quadlet/caddy.container.
DINCHY_CADDY_ADMIN_ENDPOINT=caddy-edge:2019
# The HTTP server inside the edge that this deployment writes its route into. The edge's base
# configuration (/etc/dinchy/caddy-base.json) creates it; Dinchy never creates or replaces it.
DINCHY_CADDY_EDGE_SERVER=edge
# Namespaces the configuration objects this deployment owns. Change it only to run two Dinchy
# instances behind one edge, and then make it unique per instance.
DINCHY_CADDY_TENANT=dinchy
# Hostname the edge serves the Dinchy panel on.
DINCHY_CADDY_PANEL_HOST=
# The address the edge dials to reach this API. Not the same value as DINCHY_ADDR: the app binds
# every interface, and 0.0.0.0 is not something the edge can dial. Must match the
# ContainerName in deploy/quadlet/dinchy.container.
DINCHY_CADDY_PANEL_UPSTREAM=dinchy-api:8080
# Where certificates come from: `acme` for a public domain, or `internal` for Caddy's own
# local CA (development only — nothing outside this host will trust it).
DINCHY_CADDY_TLS_ISSUER=acme
# Contact address registered with the certificate authority.
DINCHY_CADDY_ACME_EMAIL=
# Override the ACME directory URL, e.g. Let's Encrypt staging while testing.
DINCHY_CADDY_ACME_CA=
# Strict-Transport-Security max-age the edge sets on proxied responses. 0s omits the header.
DINCHY_CADDY_HSTS_MAX_AGE=8760h
DINCHY_CADDY_HSTS_INCLUDE_SUBDOMAINS=true
# Timeout for one admin API call. Loading a config can block on certificate issuance.
DINCHY_CADDY_ADMIN_TIMEOUT=30s
# Development mode: relaxed CSP. true/false.
DINCHY_DEV=false
# Where the edge forwards every non-/api request. The compiled UI is served by its own container
# (deploy/quadlet/dinchy-web.container), not from a directory: the edge fronts every application on
# this host and can read none of their files. Must match that unit's ContainerName and port.
DINCHY_FRONTEND_URL=http://dinchy-web-static:8081
# Externally reachable base URL for links in outbound email. Required when SMTP is
# enabled. Use Caddy's HTTPS URL for the panel, i.e. https://<DINCHY_CADDY_PANEL_HOST>.
DINCHY_PUBLIC_BASE_URL=

# --- Database ---
# PostgreSQL connection string. Required. Password must match POSTGRES_PASSWORD below.
# The host is the container name on dinchy.network: Postgres publishes no host port, so it is
# reachable from this application's containers and from nowhere else.
# TLS is verified end-to-end: sslrootcert must point at the CA that signed the Postgres server
# cert, and that cert must carry `dinchy-postgres` as a SAN rather than an IP — the DSN names the
# container now (see deploy/README.md).
DINCHY_POSTGRES_DSN=postgres://dinchy:change-me@dinchy-postgres:5432/dinchy?sslmode=verify-full&sslrootcert=/etc/dinchy/certs/ca.crt

# --- Auth ---
# Session cookie name.
DINCHY_AUTH_SESSION_COOKIE_NAME=dinchy_session
# Transient SSO-state cookie name.
DINCHY_AUTH_SSO_STATE_COOKIE_NAME=dinchy_sso_state
# Session idle timeout (Go duration).
DINCHY_AUTH_SESSION_IDLE_TIMEOUT=30m
# Absolute session lifetime regardless of activity (Go duration).
DINCHY_AUTH_SESSION_MAX_LIFETIME=168h
# Lifetime of a pending SSO redirect transaction (Go duration).
DINCHY_AUTH_SSO_STATE_LIFETIME=10m
# Password-reset token validity window (Go duration).
DINCHY_AUTH_PASSWORD_RESET_LIFETIME=1h
# Organization-invitation token validity window (Go duration).
DINCHY_AUTH_INVITE_LIFETIME=168h
# Issuer label shown in authenticator apps for TOTP.
DINCHY_AUTH_TOTP_ISSUER=Dinchy
# Organization name created during first-user setup.
DINCHY_AUTH_DEFAULT_ORGANIZATION_NAME=Default
# Organization slug created during first-user setup.
DINCHY_AUTH_DEFAULT_ORGANIZATION_SLUG=default

# --- SSO (env-only; a provider is enabled only when its ID, secret, and callback URL are all set) ---
# Google OAuth client ID.
DINCHY_GOOGLE_CLIENT_ID=
# Google OAuth client secret.
DINCHY_GOOGLE_CLIENT_SECRET=
# Absolute Google OAuth callback URL.
DINCHY_GOOGLE_CALLBACK_URL=
# GitHub OAuth client ID.
DINCHY_GITHUB_CLIENT_ID=
# GitHub OAuth client secret.
DINCHY_GITHUB_CLIENT_SECRET=
# Absolute GitHub OAuth callback URL.
DINCHY_GITHUB_CALLBACK_URL=
# GitLab OAuth client ID.
DINCHY_GITLAB_CLIENT_ID=
# GitLab OAuth client secret.
DINCHY_GITLAB_CLIENT_SECRET=
# Absolute GitLab OAuth callback URL.
DINCHY_GITLAB_CALLBACK_URL=

# --- SMTP / email (env-only; enabled when host or from is set) ---
# SMTP server hostname. Leave empty to disable outbound email.
DINCHY_SMTP_HOST=
# SMTP server port.
DINCHY_SMTP_PORT=587
# SMTP username (optional; omit for unauthenticated relays).
DINCHY_SMTP_USERNAME=
# SMTP password (optional).
DINCHY_SMTP_PASSWORD=
# Sender address for password-reset and invitation email.
DINCHY_SMTP_FROM=

# --- Redis (shared state + event streams, required) ---
# Redis address (host:port). Required. The container name on dinchy.network, for the same reason
# the Postgres DSN names one: nothing is published to the host.
DINCHY_REDIS_ADDR=dinchy-redis:6379
# Connect to Redis over TLS. true/false.
DINCHY_REDIS_TLS=true
# Redis username (optional).
DINCHY_REDIS_USERNAME=
# Redis password (optional).
DINCHY_REDIS_PASSWORD=
# Redis database index.
DINCHY_REDIS_DATABASE=0
# Prefix applied to all Redis keys for this instance.
DINCHY_REDIS_KEY_PREFIX=dinchy

# --- Event bus (Redis streams; drives the always-on audit subscriber) ---
# Stream name for durable event handoff.
DINCHY_EVENT_BUS_STREAM_NAME=app.events
# Prefix for per-subscriber consumer groups.
DINCHY_EVENT_BUS_CONSUMER_GROUP_PREFIX=app
# This process's consumer name within each group.
DINCHY_EVENT_BUS_CONSUMER_NAME=local
# Max stream messages processed per subscriber pass.
DINCHY_EVENT_BUS_BATCH_SIZE=100
# How long messages remain replayable in Redis (Go duration).
DINCHY_EVENT_BUS_RETENTION_WINDOW=5m
# Idle time before a pending message can be reclaimed after a crash (Go duration).
DINCHY_EVENT_BUS_CLAIM_MIN_IDLE=2m
# How long a consumer blocks waiting for new messages (Go duration).
DINCHY_EVENT_BUS_READ_BLOCK=500ms
# How often the subscriber worker wakes up (Go duration).
DINCHY_EVENT_BUS_WORKER_INTERVAL=5s

# --- Background job scheduler ---
# Maximum number of background jobs run concurrently.
DINCHY_WORKER_CONCURRENCY=10
# How long shutdown waits for in-flight jobs to drain (Go duration).
DINCHY_WORKER_SHUTDOWN_TIMEOUT=30s

# --- Durable job queue (River; Postgres-backed on-demand jobs) ---
# Maximum number of durable jobs run concurrently on the default queue.
DINCHY_JOBS_MAX_WORKERS=100

# --- Logging ---
# Log level: trace, debug, info, warn, error. trace adds SQL queries and scheduler internals.
DINCHY_LOG_LEVEL=info
# Log format: json or text. text is colored automatically when stdout is a
# terminal (local dev) and plain otherwise; keep json for production.
DINCHY_LOG_FORMAT=json
# Include source file/line in logs. true/false.
DINCHY_LOG_ADD_SOURCE=false

# --- Telemetry (OpenTelemetry) ---
# Enable OTLP trace and log exporters. true/false.
DINCHY_OTEL_ENABLED=false
# Service name reported to telemetry backends.
DINCHY_OTEL_SERVICE_NAME=dinchy
# Service version attached to telemetry resources (optional).
DINCHY_OTEL_SERVICE_VERSION=
# Deployment environment name (optional).
DINCHY_OTEL_ENVIRONMENT=
# OTLP gRPC endpoint shared by logs and traces (optional).
DINCHY_OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value headers sent to the collector (optional).
DINCHY_OTEL_EXPORTER_OTLP_HEADERS=
# Disable TLS for the OTLP gRPC connection. true/false.
DINCHY_OTEL_EXPORTER_OTLP_INSECURE=false
# Parent-based trace sampling ratio, 0.0-1.0.
DINCHY_OTEL_TRACES_SAMPLE_RATIO=1.0

# --- Postgres container (read by the postgres quadlet, not the app) ---
# Postgres role. Must match the user in DINCHY_POSTGRES_DSN.
POSTGRES_USER=dinchy
# Postgres password. Must match the password in DINCHY_POSTGRES_DSN.
POSTGRES_PASSWORD=change-me
# Postgres database name. Must match the database in DINCHY_POSTGRES_DSN.
POSTGRES_DB=dinchy
