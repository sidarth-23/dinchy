# Local development reverse proxy. Terminates TLS on https://localhost:8443 using
# Caddy's internal CA, and proxies to the Go server on 127.0.0.1:8080 (which in turn
# proxies the frontend to the Vite dev server in DINCHY_DEV mode).
#
# Production does NOT use this file — it uses the systemd Caddy unit driven by the
# app's Admin API. Run `caddy trust` once so the browser trusts the internal CA root.
{
	admin 127.0.0.1:2019
}

https://localhost:8443 {
	tls internal
	reverse_proxy 127.0.0.1:8080
}
