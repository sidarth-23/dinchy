{
    "languages": {
        "JSON": {
            "tab_size": 2,
            "preferred_line_length": 120,
            "formatter": "prettier"
        },
        "JSONC": {
            "tab_size": 2,
            "preferred_line_length": 120,
            "formatter": "prettier"
        },
        "Go": {
            "formatter": "language_server",
            "format_on_save": "on"
        }
    },
    "lsp": {
        "json-language-server": {
            "settings": {
                "json": {
                    "schemas": [
                        {
                            "name": "Dinchy i18n catalog",
                            "fileMatch": ["internal/i18n/catalog.json"],
                            "url": "./internal/i18n/catalog.schema.json"
                        },
                        {
                            "name": "Dinchy event catalog",
                            "fileMatch": ["internal/events/catalog.json"],
                            "url": "./internal/events/catalog.schema.json"
                        },
                        {
                            "name": "Dinchy error catalog",
                            "fileMatch": ["internal/errors/catalog.json"],
                            "url": "./internal/errors/catalog.schema.json"
                        }
                    ]
                }
            }
        }
    },
    "hard_tabs": false,
    "formatter": "auto",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true
}
