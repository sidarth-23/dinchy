{
    "languages": {
        "JSON": {
            "tab_size": 2,
            "preferred_line_length": 120,
            "formatter": "prettier"
        },
        "JSONC": {
            "tab_size": 2,
            "preferred_line_length": 120,
            "formatter": "prettier"
        },
        "Go": {
            "formatter": "language_server",
            "format_on_save": "on"
        },
        "Go Text Template": {
            "hard_tabs": true
        },
        "Go HTML Template": {
            "hard_tabs": false,
            "tab_size": 2
        }
    },
    "file_types": {
        "Go Text Template": ["**/*.go.tmpl", "**/*.txt.tmpl"],
        "Go HTML Template": ["**/*.html.tmpl"]
    },
    "lsp": {
        "json-language-server": {
            "settings": {
                "json": {
                    "schemas": [
                        {
                            "name": "Dinchy i18n catalog",
                            "fileMatch": ["internal/i18n/catalog/*.json"],
                            "url": "./internal/i18n/catalog.schema.json"
                        },
                        {
                            "name": "Dinchy event catalog",
                            "fileMatch": ["internal/events/catalog/*.json"],
                            "url": "./internal/events/catalog.schema.json"
                        },
                        {
                            "name": "Dinchy permission catalog",
                            "fileMatch": ["internal/access/permission/permissions.json"],
                            "url": "./internal/access/permission/permissions.schema.json"
                        },
                        {
                            "name": "Dinchy role catalog",
                            "fileMatch": ["internal/access/permission/roles.json"],
                            "url": "./internal/access/permission/roles.schema.json"
                        }
                    ]
                }
            }
        },
        "gopls": {
            "initialization_options": {
                "templateExtensions": ["tmpl"]
            }
        }
    },
    "hard_tabs": false,
    "formatter": "auto",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true
}
