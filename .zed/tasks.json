[
  // The session is now two long-lived things, and everything that used to need its own terminal
  // pane — Caddy, Vite, the Go process — is a container.
  //
  // The edge is separate because it outlives this project and is shared with every other one behind
  // it. The stack is one command because the ordering that used to matter is the container runtime's
  // job now, and because the edge restores its routes from its own autosave, so a backend starting
  // later converges rather than bootstraps.
  //
  // Deliberately only these: everything else is `task --list` in a terminal, which cannot fall out
  // of step with Taskfile.yml the way a copy here would.
  {
    "label": "Dev: start shared Caddy edge (TLS on :8443)",
    "command": "task",
    "args": ["edge:up"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dev: start stack (build, migrate, run under Delve)",
    "command": "task",
    "args": ["dev:up"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dev: follow stack logs",
    "command": "task",
    "args": ["infra:logs"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  // The edit-and-run loop: save everything, recompile from the warm build cache, reattach the
  // debugger ("Backend: API (Delve, in container)" in debug.json).
  {
    "label": "Dev: restart API (recompile)",
    "command": "task",
    "args": ["dev:watch"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Dev: bootstrap this machine",
    "command": "task",
    "args": ["bootstrap"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Check: all",
    "command": "task",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  }
]
