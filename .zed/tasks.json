[
  // Deliberately only the long-lived, order-dependent processes — the things a terminal pane is
  // genuinely better for. Everything else is `task --list` in a terminal, which cannot fall out
  // of step with Taskfile.yml the way a copy here would.
  //
  // The "Dev:" group is the startup sequence, in order. Step 4 is normally the debugger
  // ("Backend: API (Delve)" in debug.json) rather than the task below.
  {
    "label": "Dev: start infra (up, wait, migrate)",
    "command": "task",
    "args": ["dev:up"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dev: run Caddy edge (TLS on :8443)",
    "command": "task",
    "args": ["caddy:dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Dev: run web UI (Vite on :3000)",
    "command": "task",
    "args": ["web:dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Dev: run API (no debugger)",
    "command": "task",
    "args": ["dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Dev: set up machine (env, hooks, TLS trust)",
    "command": "task",
    "args": ["setup"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Check: all",
    "command": "task",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  }
]
