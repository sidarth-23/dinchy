  },
  {
    "label": "dinchy: build",
    "command": "mise",
    "args": ["run", "build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "dinchy: generate",
    "command": "mise",
    "args": ["run", "generate"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
