# Local secrets and personal overrides. Copy to .env.local (gitignored) and fill in:
#   cp .env.local.example .env.local
# Values here override .env. Never commit .env.local.

# Postgres DSN (matches compose.yaml credentials).
DINCHY_POSTGRES_DSN=postgres://dinchy:change-me@127.0.0.1:5432/dinchy?sslmode=disable

# --- Optional: SSO / SMTP secrets for local testing ---
# DINCHY_GOOGLE_CLIENT_ID=
# DINCHY_GOOGLE_CLIENT_SECRET=
# DINCHY_GOOGLE_CALLBACK_URL=
# DINCHY_SMTP_HOST=
# DINCHY_SMTP_FROM=
