# Local development defaults (non-secret; committed).
# Secrets and personal overrides go in .env.local (gitignored) — copy .env.local.example.
# Loaded by mise for dev tasks; .env.local wins over these.

# Development mode: relaxed CSP + frontend dev proxy, sensitive values revealed in logs.
DINCHY_DEV=true

# Human-readable, colored logs (color auto-enabled when stdout is a terminal).
DINCHY_LOG_FORMAT=text
DINCHY_LOG_LEVEL=debug
DINCHY_LOG_ADD_SOURCE=true

# Listen addresses.
DINCHY_ADDR=:8080
DINCHY_INTERNAL_ADDR=:9090

# Redis (local; matches compose.yaml).
DINCHY_REDIS_ADDR=127.0.0.1:6379
