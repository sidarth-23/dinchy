{
  "subscribers": [
    {
      "name": "audit",
      "description": "Persist audit events to the database"
    }
  ],
  "events": [
    {
      "name": "AuthLoginFailed",
      "type": "auth.login_failed",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "auth",
      "action": "login",
      "outcome": "failed",
      "metadata_keys": [
        "email"
      ]
    },
    {
      "name": "AuthLoginSucceeded",
      "type": "auth.login_succeeded",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "auth",
      "action": "login",
      "outcome": "succeeded",
      "metadata_keys": [
        "email",
        "organisation_slug"
      ]
    },
    {
      "name": "AuthSetupCompleted",
      "type": "auth.setup_completed",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "auth",
      "action": "setup_first_user",
      "outcome": "succeeded",
      "metadata_keys": [
        "email",
        "display_name"
      ]
    },
    {
      "name": "AuthLogoutSucceeded",
      "type": "auth.logout_succeeded",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "auth",
      "action": "logout",
      "outcome": "succeeded",
      "metadata_keys": [
        "email"
      ]
    },
    {
      "name": "AuthTwoFactorEnabled",
      "type": "auth.two_factor_enabled",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "two_factor",
      "action": "enable_totp",
      "outcome": "succeeded"
    },
    {
      "name": "AuthTwoFactorDisabled",
      "type": "auth.two_factor_disabled",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "two_factor",
      "action": "disable_totp",
      "outcome": "succeeded"
    },
    {
      "name": "AuthSSOSettingsUpdated",
      "type": "auth.sso_settings_updated",
      "module": "auth",
      "subscriber": "audit",
      "category": "security",
      "subcategory": "sso_settings",
      "action": "update_sso_settings",
      "outcome": "succeeded",
      "change_keys": [
        "client_id",
        "client_secret",
        "callback_url",
        "enabled"
      ]
    }
  ]
}
