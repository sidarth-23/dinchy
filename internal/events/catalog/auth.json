{
  "modules": [
    {
      "id": "auth",
      "description": "Authentication and account access events",
      "modules": [
        {
          "id": "security",
          "description": "Security-related events emitted by the auth module",
          "modules": [
            {
              "id": "auth",
              "description": "Authentication lifecycle events",
              "events": [
                {
                  "id": "login_failed",
                  "description": "A login attempt was rejected",
                  "action": "login",
                  "outcome": "failed",
                  "metadata_keys": [
                    {
                      "name": "email",
                      "type": "string"
                    },
                    {
                      "name": "reason",
                      "type": "string"
                    }
                  ]
                },
                {
                  "id": "login_succeeded",
                  "description": "A login attempt was accepted",
                  "action": "login",
                  "outcome": "succeeded",
                  "metadata_keys": [
                    {
                      "name": "email",
                      "type": "string"
                    },
                    {
                      "name": "organisation_slug",
                      "type": "string"
                    }
                  ]
                },
                {
                  "id": "setup_completed",
                  "description": "The initial user setup flow completed",
                  "action": "setup_first_user",
                  "outcome": "succeeded",
                  "metadata_keys": [
                    {
                      "name": "email",
                      "type": "string"
                    },
                    {
                      "name": "display_name",
                      "type": "string"
                    }
                  ]
                },
                {
                  "id": "logout_succeeded",
                  "description": "A session was revoked successfully",
                  "action": "logout",
                  "outcome": "succeeded",
                  "metadata_keys": [
                    {
                      "name": "email",
                      "type": "string"
                    }
                  ]
                }
              ]
            },
            {
              "id": "two_factor",
              "description": "Two-factor authentication events",
              "events": [
                {
                  "id": "enabled",
                  "description": "Two-factor authentication was enabled",
                  "action": "enable_totp",
                  "outcome": "succeeded"
                },
                {
                  "id": "disabled",
                  "description": "Two-factor authentication was disabled",
                  "action": "disable_totp",
                  "outcome": "succeeded"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
