{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sidarth-23/dinchy/internal/events/catalog.schema.json",
  "title": "Dinchy Event Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules"],
  "properties": {
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/module" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "outcome"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "metadata_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/typed_field" }
        },
        "change_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/typed_field" }
        }
      }
    },
    "typed_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["string", "bool", "int", "int64", "float64", "time.Time"]
        }
      }
    }
  }
}
