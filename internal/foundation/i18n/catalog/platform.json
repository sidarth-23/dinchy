{
  "modules": [
    {
      "name": "platform",
      "description": "Platform and process-level messages",
      "modules": [
        {
          "name": "config",
          "description": "Configuration messages",
          "messages": [
            {
              "name": "load_failed",
              "translations": {
                "en": "Failed to load configuration."
              }
            },
            {
              "name": "validation_failed",
              "translations": {
                "en": "Configuration is invalid."
              }
            }
          ]
        },
        {
          "name": "routing",
          "description": "Reverse proxy routing messages",
          "messages": [
            {
              "name": "invalid_host",
              "translations": {
                "en": "The domain is not a valid hostname."
              }
            },
            {
              "name": "invalid_upstream",
              "translations": {
                "en": "The upstream address must be a host and port."
              }
            },
            {
              "name": "invalid_path",
              "translations": {
                "en": "The path must start with a slash."
              }
            },
            {
              "name": "invalid_header",
              "translations": {
                "en": "The response header name or value is not allowed."
              }
            },
            {
              "name": "host_conflict",
              "translations": {
                "en": "Another route already serves this domain and path."
              }
            },
            {
              "name": "panel_host_reserved",
              "translations": {
                "en": "This domain is reserved for the Dinchy panel."
              }
            },
            {
              "name": "upstream_loop",
              "translations": {
                "en": "The upstream address points back at Dinchy itself."
              }
            },
            {
              "name": "plugin_missing",
              "translations": {
                "en": "This route needs a Caddy plugin that is not installed. Add it to deploy/caddy/plugins.txt and rebuild Caddy."
              }
            },
            {
              "name": "config_rejected",
              "translations": {
                "en": "The reverse proxy rejected the generated configuration."
              }
            },
            {
              "name": "reload_failed",
              "translations": {
                "en": "The reverse proxy could not be reloaded."
              }
            },
            {
              "name": "unavailable",
              "translations": {
                "en": "The reverse proxy is not reachable."
              }
            }
          ]
        },
        {
          "name": "server",
          "description": "Process-level fallback messages",
          "messages": [
            {
              "name": "internal_error",
              "translations": {
                "en": "An unexpected error occurred."
              }
            }
          ]
        }
      ]
    }
  ]
}
