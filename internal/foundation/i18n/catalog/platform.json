{
  "modules": [
    {
      "name": "platform",
      "description": "Platform and process-level messages",
      "modules": [
        {
          "name": "config",
          "description": "Configuration messages",
          "messages": [
            {
              "name": "load_failed",
              "translations": {
                "en": "Failed to load configuration."
              }
            },
            {
              "name": "validation_failed",
              "translations": {
                "en": "Configuration is invalid."
              }
            }
          ]
        },
        {
          "name": "routing",
          "description": "Reverse proxy routing messages",
          "messages": [
            {
              "name": "host_conflict",
              "translations": {
                "en": "Another route already serves this domain and path."
              }
            },
            {
              "name": "config_rejected",
              "translations": {
                "en": "The reverse proxy rejected the generated configuration."
              }
            },
            {
              "name": "reload_failed",
              "translations": {
                "en": "The reverse proxy could not be reloaded."
              }
            },
            {
              "name": "unavailable",
              "translations": {
                "en": "The reverse proxy is not reachable."
              }
            }
          ]
        },
        {
          "name": "server",
          "description": "Process-level fallback messages",
          "messages": [
            {
              "name": "internal_error",
              "translations": {
                "en": "An unexpected error occurred."
              }
            }
          ]
        }
      ]
    }
  ]
}
