{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sidarth-23/dinchy/internal/foundation/permission/roles.schema.json",
  "title": "Dinchy Role Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles"],
  "properties": {
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "i18n_code", "permissions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "i18n_code": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
