{
  "modules": [
    {
      "name": "auth",
      "description": "Authentication and account access messages",
      "messages": [
        {
          "name": "invalid_credentials",
          "translations": {
            "en": "Invalid email or password."
          }
        },
        {
          "name": "setup_completed",
          "params": [
            {
              "name": "resource",
              "type": "string"
            },
            {
              "name": "count",
              "type": "int"
            }
          ],
          "translations": {
            "en": "Setup has already been completed for {{.resource}} ({{.count}} users)."
          }
        },
        {
          "name": "unauthenticated",
          "translations": {
            "en": "Authentication required."
          }
        },
        {
          "name": "forbidden",
          "translations": {
            "en": "You do not have permission to perform this action."
          }
        },
        {
          "name": "organisation_required",
          "translations": {
            "en": "Choose an organisation to continue."
          }
        },
        {
          "name": "organisation_not_found",
          "translations": {
            "en": "The selected organisation is not available."
          }
        },
        {
          "name": "totp_required",
          "translations": {
            "en": "Two-factor authentication code required."
          }
        },
        {
          "name": "invalid_totp",
          "translations": {
            "en": "Invalid two-factor authentication code."
          }
        },
        {
          "name": "invalid_reset_token",
          "translations": {
            "en": "The password reset token is invalid or has expired."
          }
        },
        {
          "name": "invitation_invalid",
          "translations": {
            "en": "The invitation is invalid or has expired."
          }
        },
        {
          "name": "invitation_exists",
          "translations": {
            "en": "An active invitation already exists for that email address."
          }
        },
        {
          "name": "totp_locked",
          "translations": {
            "en": "Two-factor authentication is temporarily locked. Try again later."
          }
        }
      ],
      "modules": [
        {
          "name": "oidc",
          "description": "OpenID Connect login messages",
          "messages": [
            {
              "name": "provider_not_found",
              "params": [
                {
                  "name": "provider",
                  "type": "string"
                }
              ],
              "translations": {
                "en": "The selected OIDC provider is not available."
              }
            },
            {
              "name": "invalid_state",
              "translations": {
                "en": "The OIDC login flow is invalid or has expired."
              }
            },
            {
              "name": "login_failed",
              "translations": {
                "en": "Unable to sign in with that OIDC provider."
              }
            }
          ]
        },
        {
          "name": "sso",
          "description": "Single sign-on login messages",
          "messages": [
            {
              "name": "provider_not_found",
              "params": [
                {
                  "name": "provider",
                  "type": "string"
                }
              ],
              "translations": {
                "en": "The selected SSO provider is not available."
              }
            },
            {
              "name": "invalid_state",
              "translations": {
                "en": "The SSO login flow is invalid or has expired."
              }
            },
            {
              "name": "login_failed",
              "translations": {
                "en": "Unable to sign in with that SSO provider."
              }
            },
            {
              "name": "cache_required",
              "translations": {
                "en": "A cache store is required before SSO can be enabled."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "description": "Configuration messages",
      "messages": [
        {
          "name": "load_failed",
          "translations": {
            "en": "Failed to load configuration."
          }
        },
        {
          "name": "validation_failed",
          "translations": {
            "en": "Configuration is invalid."
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email delivery messages",
      "messages": [
        {
          "name": "not_configured",
          "translations": {
            "en": "Email delivery is not configured."
          }
        },
        {
          "name": "invitation_subject",
          "params": [
            {
              "name": "organisation",
              "type": "string"
            }
          ],
          "translations": {
            "en": "You are invited to join {{.organisation}} on Dinchy"
          }
        },
        {
          "name": "invitation_heading",
          "params": [
            {
              "name": "organisation",
              "type": "string"
            }
          ],
          "translations": {
            "en": "Join {{.organisation}} on Dinchy"
          }
        },
        {
          "name": "invitation_body",
          "params": [
            {
              "name": "organisation",
              "type": "string"
            },
            {
              "name": "role",
              "type": "string"
            }
          ],
          "translations": {
            "en": "You have been invited to join {{.organisation}} as {{.role}}. Click the button below to accept the invitation and set up your account. This invitation will expire soon."
          }
        },
        {
          "name": "invitation_cta",
          "translations": {
            "en": "Accept invitation"
          }
        },
        {
          "name": "password_reset_subject",
          "translations": {
            "en": "Reset your Dinchy password"
          }
        },
        {
          "name": "password_reset_heading",
          "translations": {
            "en": "Reset your password"
          }
        },
        {
          "name": "password_reset_body",
          "translations": {
            "en": "We received a request to reset your Dinchy password. Click the button below to choose a new one. If you did not request this, you can safely ignore this email."
          }
        },
        {
          "name": "password_reset_cta",
          "translations": {
            "en": "Reset password"
          }
        },
        {
          "name": "footer",
          "translations": {
            "en": "This is an automated message from Dinchy. Please do not reply to this email."
          }
        }
      ]
    },
    {
      "name": "request",
      "description": "Request-level messages",
      "messages": [
        {
          "name": "validation_failed",
          "translations": {
            "en": "Some fields need attention."
          }
        }
      ]
    },
    {
      "name": "security",
      "description": "Transport security messages",
      "messages": [
        {
          "name": "https_required",
          "translations": {
            "en": "This endpoint requires a secure (HTTPS) connection."
          }
        },
        {
          "name": "csrf_failed",
          "translations": {
            "en": "Missing or invalid CSRF token."
          }
        }
      ]
    },
    {
      "name": "server",
      "description": "Process-level fallback messages",
      "messages": [
        {
          "name": "internal_error",
          "translations": {
            "en": "An unexpected error occurred."
          }
        }
      ]
    }
  ]
}
