# Dinchy local development configuration.
# Copy to .env (gitignored), then adjust:  cp .env.example .env
# Optional: put personal overrides in .env.local (gitignored) — it wins over .env.
# Only this .env.example is committed; .env and .env.local are never committed.

# --- Runtime mode & logging ---
DINCHY_DEV=true
# text = colored, human-readable logs in a terminal; use json in production.
DINCHY_LOG_FORMAT=text
DINCHY_LOG_LEVEL=debug
DINCHY_LOG_ADD_SOURCE=true

# --- Server ---
# The Go server terminates HTTPS directly on :8443 using the mkcert-issued cert below
# (8443 avoids a privileged port). Open https://localhost:8443. Auth requires HTTPS.
DINCHY_ADDR=127.0.0.1:8443
DINCHY_INTERNAL_ADDR=127.0.0.1:9090
# Locally-trusted TLS cert/key from `mise run dev:certs` (mkcert).
DINCHY_TLS_CERT_FILE=deploy/certs/app.pem
DINCHY_TLS_KEY_FILE=deploy/certs/app-key.pem

# --- Local infra host ports ---
# `mise run infra:up` publishes the podman Postgres/Redis on these host ports.
# Defaults avoid 5432/6379, which are often already in use on this machine.
# If you change a port here, update the matching DSN / ADDR below to the same value.
DINCHY_POSTGRES_PORT=5433
DINCHY_REDIS_PORT=6380

# --- Datastores (host ports must match DINCHY_*_PORT above) ---
# Postgres and Redis run plaintext on loopback in dev (see compose.yaml). The app's
# own HTTPS and Mailpit's STARTTLS still use TLS; production configures datastore TLS
# separately (see deploy/dinchy.env.example).
DINCHY_POSTGRES_DSN=postgres://dinchy:change-me@127.0.0.1:5433/dinchy?sslmode=disable
DINCHY_REDIS_ADDR=127.0.0.1:6380

# --- Rootless podman networking (WSL2 only) ---
# Some WSL2 kernels have no usable nftables, which breaks netavark's default firewall
# step. If `mise run infra:up` fails with "netavark: nftables error", uncomment the
# next line — rootless port forwarding still works without the firewall driver.
# On native Linux leave it unset so podman uses its default (nftables) firewall.
#NETAVARK_FW=none

# --- Optional secrets for local testing ---
# DINCHY_GOOGLE_CLIENT_ID=
# DINCHY_GOOGLE_CLIENT_SECRET=

# --- Local mail (Mailpit; started by `mise run infra:up`) ---
# Enables the invitation + password-reset email flows in development.
# Sent mail is caught by Mailpit; read it in the web mailbox at http://localhost:8025.
# Uncomment to override the Mailpit host ports published by compose.yaml:
#DINCHY_MAILPIT_SMTP_PORT=1025
#DINCHY_MAILPIT_UI_PORT=8025
DINCHY_SMTP_HOST=localhost
DINCHY_SMTP_PORT=1025
DINCHY_SMTP_FROM=dinchy@localhost
# Mailpit enforces STARTTLS + auth like production: the app always uses mandatory
# STARTTLS and verifies Mailpit's cert (mkcert-issued, trusted via the system store).
# These credentials must match MP_SMTP_AUTH in compose.yaml.
DINCHY_SMTP_USERNAME=dinchy
DINCHY_SMTP_PASSWORD=localpass
# Public base URL for email links — the Go server's own HTTPS endpoint.
DINCHY_PUBLIC_BASE_URL=https://localhost:8443
