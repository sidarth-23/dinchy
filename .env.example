# Dinchy local development configuration.
# Copy to .env (gitignored), then adjust:  cp .env.example .env
# .env is the single source of truth for local development — mise (`[env] _.file`) and the
# Zed debugger (`.zed/debug.json` envFile) both load exactly this one file. Only this
# .env.example is committed.

# --- Runtime mode & logging ---
DINCHY_DEV=true
# text = colored, human-readable logs in a terminal; use json in production.
DINCHY_LOG_FORMAT=text
DINCHY_LOG_LEVEL=debug
DINCHY_LOG_ADD_SOURCE=true
# Adds the internal code, cause chain (including SQL errors) and metadata to every error
# response. Useful while stepping through a request; never enable it outside local debugging.
#DINCHY_EXPOSE_INTERNAL_ERRORS=true

# --- Server ---
# Caddy terminates TLS and proxies here in plaintext. This MUST stay on loopback and
# the app refuses to start otherwise: it trusts the forwarded client address and has no
# transport check of its own. Open https://localhost:8443 (Caddy), not this port.
DINCHY_ADDR=127.0.0.1:8080
DINCHY_INTERNAL_ADDR=127.0.0.1:9090
# Cookies are marked Secure because Caddy serves every route over HTTPS. Cookies are
# not scoped by port, so a non-Secure cookie minted over plaintext would replace the
# Secure one of the same name and silently end your session.
DINCHY_SECURE_COOKIES=true

# --- Caddy (reverse proxy: terminates TLS, routes the panel and every deployment) ---
# Dinchy pushes routes to Caddy's admin API once at startup; there is no Caddyfile.
DINCHY_CADDY_ENABLED=true
DINCHY_CADDY_ADMIN_ENDPOINT=127.0.0.1:2019
# Caddy serves the panel on this host and port: https://localhost:8443.
DINCHY_CADDY_PANEL_HOST=localhost
DINCHY_CADDY_HTTPS_PORT=8443
# Caddy signs its own certificates with its local CA, per host, on demand. `internal` must
# be written literally: an empty value keeps the default (acme), and no public authority
# can ever validate localhost. `task setup` installs the CA root so the browser accepts them.
DINCHY_CADDY_TLS_ISSUER=internal
# HSTS off locally: pinning it on localhost forces HTTPS on every other plaintext dev
# server on this machine, and browsers make that hard to undo. Literal 0s, not empty.
DINCHY_CADDY_HSTS_MAX_AGE=0s

# --- Frontend (served by Caddy, never through Dinchy) ---
# In dev Caddy forwards non-/api requests to the Vite dev server on this URL. The port is
# pinned in web/vite.config.ts (strictPort), so the two cannot drift apart silently.
DINCHY_DEV_PROXY_URL=http://127.0.0.1:3000
# Outside dev mode Caddy serves the compiled UI from here instead.
DINCHY_FRONTEND_ROOT=web/dist

# --- Local infra host ports ---
# `task infra:up` publishes the podman Postgres/Redis on these host ports; compose.yaml
# defaults to the same values when these are unset.
# If you change a port here, update the matching DSN / ADDR below to the same value.
# Redis is off 6379 because a system Redis commonly holds it; move Postgres off 5432 the same
# way if you already run one locally.
DINCHY_POSTGRES_PORT=5432
DINCHY_REDIS_PORT=6380

# --- Datastores (host ports must match DINCHY_*_PORT above) ---
# Postgres and Redis run plaintext on loopback in dev (see compose.yaml). Caddy's HTTPS
# and Mailpit's STARTTLS still use TLS; production configures datastore TLS separately
# (see deploy/dinchy.env.example).
DINCHY_POSTGRES_DSN=postgres://dinchy:change-me@127.0.0.1:5432/dinchy?sslmode=disable
DINCHY_REDIS_ADDR=127.0.0.1:6380

# --- Rootless podman networking (WSL2 only) ---
# Some WSL2 kernels have no usable nftables, which breaks netavark's default firewall
# step. If `task infra:up` fails with "netavark: nftables error", uncomment the
# next line — rootless port forwarding still works without the firewall driver.
# On native Linux leave it unset so podman uses its default (nftables) firewall.
#NETAVARK_FW=none

# --- Optional secrets for local testing ---
# DINCHY_GOOGLE_CLIENT_ID=
# DINCHY_GOOGLE_CLIENT_SECRET=

# --- Local mail (Mailpit; started by `task infra:up`) ---
# Enables the invitation + password-reset email flows in development.
# Sent mail is caught by Mailpit; read it in the web mailbox at http://localhost:8025.
# Uncomment to override the Mailpit host ports published by compose.yaml:
#DINCHY_MAILPIT_SMTP_PORT=1025
#DINCHY_MAILPIT_UI_PORT=8025
DINCHY_SMTP_HOST=localhost
DINCHY_SMTP_PORT=1025
DINCHY_SMTP_FROM=dinchy@localhost
# Mailpit enforces STARTTLS + auth like production: the app always uses mandatory
# STARTTLS and verifies Mailpit's cert (mkcert-issued, trusted via the system store).
# These credentials must match MP_SMTP_AUTH in compose.yaml.
DINCHY_SMTP_USERNAME=dinchy
DINCHY_SMTP_PASSWORD=localpass
# Public base URL for email links — Caddy's HTTPS endpoint for the panel.
DINCHY_PUBLIC_BASE_URL=https://localhost:8443
