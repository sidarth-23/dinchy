# Dinchy local development configuration.
# Copy to .env (gitignored), then adjust:  cp .env.example .env
# .env is the single source of truth for local development — task (`dotenv:`), mise
# (`[env] _.file`) and every container in compose.yaml (`env_file:`) load exactly this one file.
# Only this .env.example is committed.
#
# Almost everything here is application configuration, sourced from internal/config. The paths
# compose bind-mounts are exported by Taskfile.yml instead and are deliberately absent. The one
# other exception is the block of published-port knobs at the end: compose reads those, not the
# binary, but they are the values a second checkout on the same machine has to move, so they are
# documented here rather than hidden.
#
# Run `task env:check` after pulling: it reports keys that exist here and not in your .env, which
# is how a renamed variable stops being a silent misconfiguration.

# --- Runtime mode & logging ---
DINCHY_DEV=true
# text = colored, human-readable logs in a terminal; use json in production.
DINCHY_LOG_FORMAT=text
DINCHY_LOG_LEVEL=debug
DINCHY_LOG_ADD_SOURCE=true
# Adds the internal code, cause chain (including SQL errors) and metadata to every error
# response. Useful while stepping through a request; never enable it outside local debugging.
#DINCHY_EXPOSE_INTERNAL_ERRORS=true

# --- Server ---
# The app runs in a container and the shared Caddy edge reaches it across the caddy-edge network,
# so it binds every interface rather than loopback. Open https://localhost:8443 (the edge), never
# this port — it is not published to your machine at all.
DINCHY_ADDR=0.0.0.0:8080
# Which peers' X-Forwarded-For the app honours. This is what makes the client address recorded in
# audit_logs.ip_address one the peer could not choose, now that the listener faces a network: a
# request from anywhere else on caddy-edge is recorded as itself.
#
# 10.89.100.0/24 is the subnet `task edge:net` pins for caddy-edge. The app refuses to start with a
# listener reachable beyond loopback and only loopback trusted, because it would silently record the
# edge's own address for every request.
DINCHY_TRUSTED_PROXIES=10.89.100.0/24,127.0.0.1/32,::1/128
# Health and readiness, on loopback: the check runs inside the container, so there is nothing to
# gain from putting it on the network.
DINCHY_INTERNAL_ADDR=127.0.0.1:9090
# Cookies are marked Secure because the edge serves every route over HTTPS. Cookies are
# not scoped by port, so a non-Secure cookie minted over plaintext would replace the
# Secure one of the same name and silently end your session.
DINCHY_SECURE_COOKIES=true

# --- The shared Caddy edge ---
# One Caddy fronts every application on this machine. It is the only thing that publishes a host
# port, it has its own lifecycle (`task edge:up`), and Dinchy writes only the two configuration
# objects it owns. There is no Caddyfile — see deploy/caddy/README.md.
DINCHY_CADDY_ENABLED=true
# The edge's admin API, reached by container name over caddy-edge. It is also published on
# 127.0.0.1:2019 for `caddy trust`, but the app uses the network route.
DINCHY_CADDY_ADMIN_ENDPOINT=caddy-edge:2019
# The HTTP server inside the edge that this deployment writes its route into. The edge's base
# configuration creates it; Dinchy never does.
DINCHY_CADDY_EDGE_SERVER=edge
# Namespaces the objects this deployment owns. Change it only to run two Dinchy instances behind
# one edge.
DINCHY_CADDY_TENANT=dinchy
# The edge serves the panel on this host: https://localhost:8443.
DINCHY_CADDY_PANEL_HOST=localhost
# The address the edge dials for the API. Not the same value as DINCHY_ADDR: the app binds every
# interface, and 0.0.0.0 is not something the edge can dial.
DINCHY_CADDY_PANEL_UPSTREAM=dinchy-api:8080
# Caddy signs its own certificates with its local CA, per host, on demand. `internal` must
# be written literally: an empty value keeps the default (acme), and no public authority
# can ever validate localhost. `task bootstrap` installs the CA root so the browser accepts them.
DINCHY_CADDY_TLS_ISSUER=internal
# HSTS off locally: pinning it on localhost forces HTTPS on every other plaintext dev
# server on this machine, and browsers make that hard to undo. Literal 0s, not empty.
DINCHY_CADDY_HSTS_MAX_AGE=0s

# --- Frontend (proxied by the edge, never through Dinchy) ---
# The edge forwards every non-/api request here: the Vite dev server in development, a static
# server beside the app otherwise. The edge reads no files — it is shared between applications and
# can see none of theirs. The port is pinned in web/vite.config.ts (strictPort), so the two cannot
# drift apart silently.
DINCHY_FRONTEND_URL=http://dinchy-web:3000

# --- Datastores (internal to this project's network; nothing is published) ---
# Both are reached by container name. There is no host port to collide with another project's, and
# no host client can reach them — `task db:migrate` and `task db:shell` go through a container.
DINCHY_POSTGRES_DSN=postgres://dinchy:change-me@postgres:5432/dinchy?sslmode=disable
DINCHY_REDIS_ADDR=redis:6379

# --- Rootless podman networking (WSL2 only) ---
# Some WSL2 kernels have no usable nftables, which breaks netavark's default firewall
# step. If `task infra:up` fails with "netavark: nftables error", uncomment the
# next line — rootless port forwarding still works without the firewall driver.
# On native Linux leave it unset so podman uses its default (nftables) firewall.
#NETAVARK_FW=none

# --- Optional secrets for local testing ---
# DINCHY_GOOGLE_CLIENT_ID=
# DINCHY_GOOGLE_CLIENT_SECRET=

# --- Local mail (Mailpit; started with the stack by `task dev:up`) ---
# Enables the invitation + password-reset email flows in development.
# Sent mail is caught by Mailpit; read it in the web mailbox at http://localhost:8025. That UI is
# the one dev-tool port still published — move it in your .env if a second project wants it.
DINCHY_SMTP_HOST=mailpit
DINCHY_SMTP_PORT=1025
DINCHY_SMTP_FROM=dinchy@localhost
# Mailpit enforces STARTTLS + auth like production: the app always uses mandatory STARTTLS and
# verifies Mailpit's certificate. That certificate is mkcert-issued, and the backend container
# trusts mkcert's root through SSL_CERT_DIR (set in compose.yaml) — the image's own CA bundle knows
# nothing about it. `task tls:mailpit-cert` issues it for the name `mailpit`, which is why
# DINCHY_SMTP_HOST above is that name and not localhost.
# These credentials must match MP_SMTP_AUTH in compose.yaml.
DINCHY_SMTP_USERNAME=dinchy
DINCHY_SMTP_PASSWORD=localpass
# Public base URL for email links — the edge's HTTPS endpoint for the panel.
DINCHY_PUBLIC_BASE_URL=https://localhost:8443

# --- Published ports (read by compose, not by the binary) ---
# The only ports this project puts on your machine, all on loopback. Every one is here because a
# second checkout — or an unrelated container — will collide with it, and moving it is how you run
# two projects at once. Uncomment and change rather than editing compose.yaml.
#
# The debugger's port. It also has to match .zed/debug.json, which cannot read this file: Zed
# expands only its own $ZED_* variables.
#DINCHY_DEV_DELVE_PORT=2345
# Mailpit's web mailbox.
#DINCHY_MAILPIT_UI_PORT=8025
# The edge's HTTPS port and admin API. These belong to the *shared* edge, so changing them affects
# every project behind it — and DINCHY_CADDY_HTTPS_PORT-style values in deploy/caddy/base.dev.json
# must be changed to match, because Caddy generates port-bearing redirects from https_port.
#DINCHY_DEV_HTTPS_PORT=8443
#DINCHY_DEV_ADMIN_PORT=2019
