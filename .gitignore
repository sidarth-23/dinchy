# Go
/dinchy
/dinchy-update
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/
/dist/
tmp

# Local dev env files — only *.example templates are committed
/.env
/.env.*
!/.env*.example

# Local dev TLS material from mkcert (never committed; the generator script is tracked)
/deploy/certs/*.pem

# Frontend
web/node_modules/
web/dist/
web/.env
web/.env.local

# Runtime
*.db
*.db-shm
*.db-wal
dinchy.old

# Editor
.vscode/
.idea/
*.swp
*.swo

# Delve debug binaries (Zed/dlv `mode: debug` drops these in the repo root)
/__debug_bin*
