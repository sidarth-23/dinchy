# Go build output
/dinchy
/dinchy-update
dinchy.old
/vendor/
/dist/
tmp
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test and coverage artifacts
*.test
*.out

# Delve debug binaries (Zed/dlv `mode: debug` drops these in the repo root)
/__debug_bin*

# Frontend (web/) — dependencies, build output, and tool caches
web/node_modules/
web/dist/
web/.tanstack/
web/**/*.local

# Local dev env files — only *.example templates are committed
/.env
/.env.*
!/.env*.example
web/.env
web/.env.*
!web/.env*.example

# Task's fingerprint cache for its sources/generates checks
/.task/

# Runtime data
*.db
*.db-shm
*.db-wal

# Editor and OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
